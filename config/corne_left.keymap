/*
 * Corne keymap (ZMK, nice!nano v2 + SSD1306 OLED)
 *
 * Layer (angka tampil di OLED):
 *   0  default : QWERTY
 *   1  lower   : angka, Bluetooth, navigasi
 *   2  raise   : simbol, media key
 *   3  mouse   : kursor, klik, scroll  ->  aktif lewat &mo3 di thumb
 *
 * Notasi: MB3/MB4/MB5 = tombol mouse 3/4/5, PIPE = '|'
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

        #ifndef ZMK_POINTING_DEFAULT_MOVE_VAL
#define ZMK_POINTING_DEFAULT_MOVE_VAL 900
#endif

#ifndef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25
#endif

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

/ {
        behaviors {
                /omit-if-no-ref/ mmv {
                        compatible = "zmk,behavior-input-two-axis";
                        #binding-cells = <1>;
                        x-input-code = <INPUT_REL_X>;
                        y-input-code = <INPUT_REL_Y>;
                        time-to-max-speed-ms = <250>;
                        acceleration-exponent = <2>;
                        input-processors = <&zip_xy_scaler 8 5>;
                };

                /omit-if-no-ref/ msc {
                        compatible = "zmk,behavior-input-two-axis";
                        #binding-cells = <1>;
                        x-input-code = <INPUT_REL_HWHEEL>;
                        y-input-code = <INPUT_REL_WHEEL>;
                        time-to-max-speed-ms = <250>;
                        acceleration-exponent = <1>;
                        input-processors = <&zip_scroll_scaler 11 5>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "0";
//       | TAB  | Q    | W    | E    | R    | T    | Y    | U    | I    | O    | P    | BSPC  |
//       | SHFT | A    | S    | D    | F    | G    | H    | J    | K    | L    | ;    | '/SFT |
//       | CTRL | Z    | X    | C    | V    | B    | N    | M    | ,    | .    | /    | ES/CTL|
//       | ALT  | LWR  | SPC | &mo3 | RSE  | GUI  |
                        bindings = <
   &kp TAB   &kp Q   &kp W   &kp E   &kp R   &kp T    &kp Y   &kp U  &kp I  &kp O  &kp P  &kp BSPC
   &kp LSHFT &kp A   &kp S   &kp D   &kp F   &kp G    &kp H   &kp J  &kp K  &kp L  &kp SEMI &mt LSHFT SQT
   &kp LCTRL &kp Z   &kp X   &kp C   &kp V   &kp B    &kp N   &kp M  &kp COMMA &kp DOT &kp FSLH &mt LCTRL ESC
                   &kp LALT &mo 1 &kp SPACE &mo 3 &mo 2 &kp LGUI
                        >;
                };

                lower_layer {
                        display-name = "1";
//       | TAB  | 1    | 2    | 3    | 4    | 5    | 6    | 7    | 8    | 9    | 0    | BSPC|
//       | SHFT | BT1  | BT2  | BT3  | BT4  | BT5  | MENU | LEFT | UP   | DOWN | RIGHT|     |
//       | CTRL | UNLK |      |      | BTCLR|      |      |      |      |      |      |     |
//       | ALT  | LWR  | SPC | &mo3 | RSE  | GUI  |
                        bindings = <
   &kp TAB   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC
   &kp LSHFT &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp K_CONTEXT_MENU &kp LEFT &kp UP &kp DOWN &kp RIGHT &trans
   &kp LCTRL &studio_unlock &trans &trans &bt BT_CLR &trans &trans &trans &trans &trans &trans &trans
                   &kp LALT &mo 1 &kp SPACE &mo 3 &mo 2 &kp LGUI
                        >;
                };

                raise_layer {
                        display-name = "2";
//       | TAB  | !    | @    | #     | $    | %     | ^    | &    | *    | (    | )    | DEL |
//       | CAPS |      | PRTSC| BRDN  | BRUP |       | -    | =    | [    | ]    | BSLH | `   |
//       | CTRL |      |      | VOLDN | VOLUP|       | _    | +    | {    | }    | PIPE | ~   |
//       | ALT  | LWR  | SPC | &mo3 | RSE  | GUI  |
                        bindings = <
   &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp DEL
   &kp CAPS  &trans   &kp PRINTSCREEN &kp C_BRI_DN &kp C_BRI_UP &trans &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &kp GRAVE
   &kp LCTRL &trans   &trans &kp K_VOL_DN &kp K_VOL_UP &trans &kp UNDER &kp PLUS &kp LBRC &kp RBRC &kp PIPE &kp TILDE
                   &kp LALT &mo 1 &kp SPACE &mo 3 &mo 2 &kp LGUI
                        >;
                };

                mouse_layer {
                        display-name = "3";
//       |      |      |       | MOVEU |       |       | SCRLL | SCRLR | MB3  | MB4  | MB5  |    |
//       |      |      | MOVEL | MOVED | MOVER |       | SCRLU | LCLK  | RCLK |      |      |    |
//       |      |      |       |       |       |       | SCRLD |       |      |      |      |    |
//       |      |      | ENT   |       |       |       |
                        bindings = <
&none &none &none &mmv MOVE_UP &none &none &msc SCRL_LEFT &msc SCRL_RIGHT &mkp MB3 &mkp MB4 &mkp MB5 &none
  &trans &none &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &msc SCRL_UP &mkp LCLK &mkp RCLK &none &none &none
  &trans &none &none &none &none &none &msc SCRL_DOWN &none &none &none &none &none
                  &trans &trans &kp RET &trans &trans &trans
                        >;
                };
        };
};